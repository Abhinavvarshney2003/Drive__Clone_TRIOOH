# ── DGDrive Backend Environment Variables ──
# Copy this file to .env and fill in your values

# REQUIRED: Secret key for signing JWT tokens (min 32 characters)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Environment: 'production' or 'development'
NODE_ENV=production

# Port (Pterodactyl sets SERVER_PORT automatically)
PORT=3000

# Allowed CORS origin (your frontend domain)
CORS_ORIGIN=http://photodrive.triooh.agency,https://photodrive.triooh.agency

# Max file upload size in MB
MAX_UPLOAD_MB=10

# ── MySQL Database Configuration ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=safebjt6_DGDrive_triooh
DB_PASSWORD=your-database-password-here
DB_NAME=safebjt6_DGDrive_triooh
